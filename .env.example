# Backend API URL - Set to your backend URL (use http://localhost:8000 for local development)
# For production deployment on Hugging Face Spaces, use your space URL like: https://your-username-hf-space-name.hf.space

REACT_APP_BACKEND_URL=http://localhost:8000


# Alternative environment variable name (for Vercel deployments)
# For production deployment, set this to your Hugging Face Space URL (e.g., https://your-username-hf-space-name.hf.space)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Additional configuration
REACT_APP_DEBUG=true